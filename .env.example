# Copy to .env.local for local overrides (optional — credentials are in supabase/info.tsx)

# Production site URL (required on Vercel for Google OAuth redirects)
# Use your real Vercel URL, e.g. https://ezegerty1.vercel.app
VITE_SITE_URL=https://your-project.vercel.app

# Optional: override Supabase (defaults come from supabase/info.tsx)
# VITE_SUPABASE_URL=https://pezhnoaegqjbbyfqwavy.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated emails allowed to sign in as admin on /admin-login
# VITE_ADMIN_EMAILS=you@example.com,admin@ezgerty.com

# Staff portal secret codes (change in production — set in Vercel env)
# VITE_ADMIN_ACCESS_CODE=EzgAdmin#2026!K9mX7pL2
# VITE_DELIVERY_ACCESS_CODE=EzgDrv#2026!R4nQ8wZ5

# Local dev: usually leave VITE_SITE_URL unset (app uses http://127.0.0.1:5173)
